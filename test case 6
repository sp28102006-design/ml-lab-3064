def predict_student_performance(study_hours, attendance):
    cpt_pass = {
        (0, 0): 0.05,
        (0, 1): 0.40,
        (1, 0): 0.60,
        (1, 1): 0.95
    }

    prob_pass = cpt_pass.get((study_hours, attendance))
    prob_fail = 1 - prob_pass

    return prob_pass, prob_fail

study = 1
attend = 0

p_pass, p_fail = predict_student_performance(study, attend)

print(f"Inference for Study={study}, Attendance={attend}:")
print(f"Probability of Passing: {p_pass * 100}%")
print(f"Probability of Failing: {p_fail * 100}%")

prediction = "PASS" if p_pass > p_fail else "FAIL"
print(f"Final Prediction: {prediction}")
